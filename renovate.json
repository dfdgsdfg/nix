{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Asia/Seoul",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "minimumReleaseAge": "3 days",
  "automerge": false,
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "description": "Refresh flake.lock without the individual release age delay",
      "matchManagers": [
        "nix"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "home/**",
        "system/**"
      ],
      "addLabels": [
        "needs-hash"
      ],
      "automerge": false,
      "matchDepNames": [
        "!can1357/oh-my-pi",
        "!stablyai/orca",
        "!rustdesk/rustdesk",
        "!xtool-org/xtool",
        "!OpenHV/OpenHV",
        "!herdrdev/herdr",
        "!hashicorp/terraform",
        "!openai/codex",
        "!block/buzz",
        "!localsend/localsend",
        "!telegramdesktop/tdesktop",
        "!zackb/tether",
        "!zed-industries/zed"
      ]
    },
    {
      "description": "Refresh all platform hashes for supported upstream binary releases",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "can1357/oh-my-pi",
        "stablyai/orca",
        "rustdesk/rustdesk",
        "xtool-org/xtool",
        "OpenHV/OpenHV",
        "herdrdev/herdr",
        "hashicorp/terraform",
        "openai/codex",
        "block/buzz",
        "localsend/localsend",
        "telegramdesktop/tdesktop",
        "zackb/tether",
        "zed-industries/zed"
      ],
      "automerge": false,
      "postUpgradeTasks": {
        "commands": [
          "python3 scripts/renovate-release-hashes.py"
        ],
        "dataFileTemplate": "[{{#each upgrades}}{\"depName\":{{{toJSON depName}}},\"packageFile\":{{{toJSON packageFile}}},\"newValue\":{{{toJSON newValue}}} }{{#unless @last}},{{/unless}}{{/each}}]",
        "fileFilters": [
          "home/modules/desktop/apps.nix",
          "home/modules/desktop/dev.nix",
          "home/modules/desktop/games.nix",
          "home/modules/omp/default.nix",
          "home/packages/upstream-binaries.nix"
        ],
        "executionMode": "branch"
      },
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "Update Determinate through lock maintenance; read the root nixpkgs channel directly with the regex manager",
      "matchManagers": [
        "nix"
      ],
      "matchDepNames": [
        "determinate",
        "nixpkgs"
      ],
      "enabled": false
    }
  ],
  "customDatasources": {
    "gnome-auto-move-windows": {
      "defaultRegistryUrlTemplate": "https://extensions.gnome.org/extension-info/?pk=16",
      "format": "json",
      "transformTemplates": [
        "{\"releases\":[{\"version\": $string($lookup(shell_version_map, \"50\").version)}], \"homepage\": \"https://extensions.gnome.org/extension/16/auto-move-windows/\"}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Stable root nixpkgs channel, independent of flake.lock node names",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "nixpkgs\\.url\\s*=\\s*\"github:nixos/nixpkgs/(?<currentValue>nixos-\\d{2}\\.\\d{2})\";"
      ],
      "depNameTemplate": "nixpkgs",
      "packageNameTemplate": "https://github.com/NixOS/nixpkgs",
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "nixpkgs"
    },
    {
      "customType": "regex",
      "description": "GitHub release versions used by fetchurl packages",
      "managerFilePatterns": [
        "/^home\\/(modules\\/(omp\\/default|desktop\\/(apps|dev|games))|packages\\/upstream-binaries)\\.nix$/"
      ],
      "matchStrings": [
        "version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\";\\s*src = pkgs\\.fetchurl \\{\\s*url = \"https://github\\.com/(?<depName>[^\"/]+/[^\"/]+)/releases/download/(?:v|rust-v)?\\$\\{version\\}/"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?:rust-)?v?(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Buzz desktop release with desktop-v GitHub tag",
      "managerFilePatterns": [
        "/^home\\/packages\\/upstream-binaries\\.nix$/"
      ],
      "matchStrings": [
        "pname = \"buzz\";\\s*version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\";"
      ],
      "depNameTemplate": "block/buzz",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^desktop-v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Herdr release shared across Linux and Darwin source URLs",
      "managerFilePatterns": [
        "/^home\\/packages\\/upstream-binaries\\.nix$/"
      ],
      "matchStrings": [
        "pname = \"herdr\";\\s*version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\";"
      ],
      "depNameTemplate": "herdrdev/herdr",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "OpenEmux release used by the source package",
      "managerFilePatterns": [
        "/^home\\/modules\\/desktop\\/games\\.nix$/"
      ],
      "matchStrings": [
        "pname = \"openemux\";\\s*version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\";"
      ],
      "depNameTemplate": "guilhermefeitosa66/OpenEmux",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Terraform release used by the upstream binary package",
      "managerFilePatterns": [
        "/^home\\/packages\\/upstream-binaries\\.nix$/"
      ],
      "matchStrings": [
        "pname = \"terraform\";\\s*version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\";"
      ],
      "depNameTemplate": "hashicorp/terraform",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "OpenHV calendar-style GitHub release version",
      "managerFilePatterns": [
        "/^home\\/modules\\/desktop\\/games\\.nix$/"
      ],
      "matchStrings": [
        "version = \"(?<currentValue>\\d{8})\";\\s*src = pkgs\\.fetchurl \\{\\s*url = \"https://github\\.com/(?<depName>OpenHV/OpenHV)/releases/download/\\$\\{version\\}/"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Kime GitHub tag used by the Nix overlay",
      "managerFilePatterns": [
        "/^system\\/overlays\\/kime\\.nix$/"
      ],
      "matchStrings": [
        "version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\";\\s*src = final\\.fetchFromGitHub \\{\\s*owner = \"(?<owner>Riey)\";\\s*repo = \"(?<repo>kime)\";\\s*rev = \"v\\$\\{version\\}\";"
      ],
      "depNameTemplate": "{{owner}}/{{repo}}",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Zed GitHub release used by the upstream binary package",
      "managerFilePatterns": [
        "/^home\\/packages\\/upstream-binaries\\.nix$/"
      ],
      "matchStrings": [
        "pname = \"zed-editor\";\\s*version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\";"
      ],
      "depNameTemplate": "zed-industries/zed",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Auto Move Windows release compatible with GNOME Shell 50",
      "managerFilePatterns": [
        "/^home\\/modules\\/desktop\\/gnome\\.nix$/"
      ],
      "matchStrings": [
        "version = \"(?<currentValue>\\d+)\";\\s*src = pkgs\\.fetchzip"
      ],
      "depNameTemplate": "Auto Move Windows for GNOME 50",
      "datasourceTemplate": "custom.gnome-auto-move-windows",
      "versioningTemplate": "loose"
    }
  ]
}
